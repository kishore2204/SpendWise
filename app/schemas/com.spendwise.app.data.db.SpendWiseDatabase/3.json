      {
        "viewName": "v_share_excluded",
        "createSql": "CREATE VIEW `${VIEW_NAME}` AS SELECT s.id AS shareId, s.friendId AS friendId, t.id AS txnId, t.accountId AS accountId, t.localEpochDay AS localEpochDay,\n               CASE WHEN s.forgivenAt IS NULL THEN s.amountPaise\n                    ELSE COALESCE((SELECT SUM(x.amountPaise) FROM settlement x WHERE x.shareId = s.id), 0) END AS excludedPaise\n        FROM shared_share s JOIN v_confirmed_txn t ON t.id = s.txnId"
      }

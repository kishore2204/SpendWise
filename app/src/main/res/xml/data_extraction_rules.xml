<?xml version="1.0" encoding="utf-8"?>
<!--
    ADR-002: financial data never leaves the device through Android backup.
    allowBackup="false" alone does not block device-to-device transfer (incl. Samsung Smart Switch) on Android 12+,
    so every domain is excluded for both cloud backup and device transfer.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>

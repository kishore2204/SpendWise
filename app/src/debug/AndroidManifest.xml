<?xml version="1.0" encoding="utf-8"?>
<!-- Debug build only: test-data tools. Never merged into release. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- Seeds fake bank SMS. DUMP is held by the adb shell, never by apps, so only adb can trigger it. -->
        <receiver
            android:name=".debugtools.DebugSeedReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.spendwise.debug.SEED_SMS" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
